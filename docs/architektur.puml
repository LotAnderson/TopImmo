title
TopImmo – Backend: Authentifizierung und SQLite
Stand: 05.10.2026
end title
top to bottom direction
package "Controller" {
  class "AuthController" as AuthController {
    +Register(request : RegisterRequest) : Task<IActionResult>
    +Login(request : LoginRequest) : Task<IActionResult>
    +Refresh(request : RefreshRequest) : Task<IActionResult>
  }
}
package "Dienste" {
  interface "IAuthService" as IAuthService {
    +RegisterAsync(request : RegisterRequest) : Task<AuthResult>
    +LoginAsync(request : LoginRequest) : Task<LoginResult>
    +RefreshAsync(request : RefreshRequest) : Task<LoginResult>
  }
  class "AuthService" as BackendAuthService {
    +RegisterAsync(request : RegisterRequest) : Task<AuthResult>
    +LoginAsync(request : LoginRequest) : Task<LoginResult>
    +RefreshAsync(request : RefreshRequest) : Task<LoginResult>
  }
  interface "ITokenService" as ITokenService {
    +GenerateAccessToken(user : User) : string
    +GenerateRefreshToken() : string
  }
  class "TokenService" as TokenService {
    +GenerateAccessToken(user : User) : string
    +GenerateRefreshToken() : string
  }
}
package "Konfiguration" {
  class "JwtSettings" as JwtSettings {
    +Key : string
    +Issuer : string
    +ExpireMinutes : int
  }
}
package "SQLite / EF Core" {
  class "AppDbContext" as AppDbContext {
    +Users : DbSet<User>
    +RefreshTokens : DbSet<RefreshToken>
  }
  class "DbContext" as DbContext <<framework>> {
  }
  class "User" as User <<entity>> {
    +Id : int
    +Email : string
    +PasswordHash : string
    +RefreshTokens : List<RefreshToken>
  }
  class "RefreshToken" as RefreshToken <<entity>> {
    +Id : int
    +Token : string
    +ExpiresAt : DateTime
    +IsRevoked : bool
    +UserId : int
    +User : User
  }
}
AuthController ..> IAuthService : injiziert
BackendAuthService ..|> IAuthService : implementiert
BackendAuthService ..> AppDbContext : Konten und Rotation
BackendAuthService ..> ITokenService : injiziert
TokenService ..|> ITokenService : implementiert
TokenService ..> JwtSettings : IOptions
TokenService ..> User : Claims aus Konto
AppDbContext --|> DbContext : erbt
AppDbContext --> User : Users
AppDbContext --> RefreshToken : RefreshTokens
User "1" -- "0..*" RefreshToken : UserId / Navigation
legend bottom left
  Öffentlich (+); privat (-); statisch ({static}).
  Gestrichelter Pfeil: verwendet.
  Hohles Dreieck: implementiert (gestrichelt) oder erbt (durchgezogen).
  Gefüllte Raute: Template-Komposition; Pfeil: Objektbeziehung.
  Program.cs registriert IAuthService -> AuthService und ITokenService -> TokenService.
  BCrypt: Passwort-Hash; HS256: JWT-Signatur; zufälliger Refresh-Token: 7 Tage.
  JwtBearer validiert Signatur, Issuer und Ablauf vor dem Zugriff auf [Authorize]-Endpunkte.
  DTOs: RegisterRequest / LoginRequest (Email, Password), RefreshRequest (RefreshToken).
  Ergebnisse: AuthResult und LoginResult sind unabhängige Klassen; keine Vererbung.
endlegend
@enduml

